# Claude API key. Leave empty and Cue runs entirely on its offline template engine.
ANTHROPIC_API_KEY=

# Model and effort for generation (defaults shown). claude-sonnet-5 or claude-haiku-4-5 are cheaper and faster.
CUE_MODEL=claude-opus-5
CUE_EFFORT=medium

# Per-IP limits for the AI endpoints (best effort, in memory).
CUE_RATE_PER_MIN=10
CUE_RATE_PER_DAY=80
